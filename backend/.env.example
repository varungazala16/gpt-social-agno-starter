# Application Settings
PROJECT_NAME="GPT Social"
API_V1_STR="/api/v1"
SECRET_KEY="changethis"  # Change this to a secure random string
ENVIRONMENT="local"

# CORS Settings
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Supabase Settings
SUPABASE_URL="your-supabase-project-url"
SUPABASE_KEY="your-supabase-anon-key"

# PostgreSQL Database Settings (for Supabase)
POSTGRES_SERVER="your-supabase-db-host"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-supabase-db-password"
POSTGRES_DB="postgres"

# Superuser Settings
FIRST_SUPERUSER="admin@example.com"
FIRST_SUPERUSER_PASSWORD="changethis"

# TikTok Settings
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:8000/api/v1/tiktok/oauth2/callback/"

# Instagram Settings
INSTAGRAM_CLIENT_ID="your-instagram-client-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-client-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:8000/api/v1/instagram/oauth2/callback/"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# YouTube Settings
YOUTUBE_CLIENT_ID="your-youtube-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:8000/api/v1/youtube/oauth2/callback"
