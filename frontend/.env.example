# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# For Remote Supabase (Production/Staging)
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# For Local Supabase Development (Recommended for development)
# Uncomment these lines when using local Supabase (started with `npm run supabase:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# API Configuration
# Backend API base URL for social account connections and other API calls
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Admin Configuration
# Set this to the email address of the admin user
ADMIN_EMAIL=admin@example.com

OPENAI_API_KEY=asdfasdf
